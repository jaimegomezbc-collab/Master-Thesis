ninja_required_version = 1.3
cxx = c++
nvcc = C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.3/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=fused -DTORCH_API_INCLUDE_EXTENSION_H -isystem /cs/student/project_msc/2025/aibh/jgomezbe/conda/envs/MUDiff/lib/python3.10/site-packages/torch/include -isystem /cs/student/project_msc/2025/aibh/jgomezbe/conda/envs/MUDiff/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem 'C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.3/include' -isystem /cs/student/project_msc/2025/aibh/jgomezbe/conda/envs/MUDiff/include/python3.10 -fPIC -std=c++20 -O3 -std=c++17
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=fused -DTORCH_API_INCLUDE_EXTENSION_H -isystem /cs/student/project_msc/2025/aibh/jgomezbe/conda/envs/MUDiff/lib/python3.10/site-packages/torch/include -isystem /cs/student/project_msc/2025/aibh/jgomezbe/conda/envs/MUDiff/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem 'C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.3/include' -isystem /cs/student/project_msc/2025/aibh/jgomezbe/conda/envs/MUDiff/include/python3.10 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_80,code=sm_80 --compiler-options '-fPIC' -O3 -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/cs/student/project_msc/2025/aibh/jgomezbe/conda/envs/MUDiff/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -LC:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.3/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build fused_bias_act.o: compile /cs/student/project_msc/2025/aibh/jgomezbe/Master-Thesis/utils/op/fused_bias_act.cpp
build fused_bias_act_kernel.cuda.o: cuda_compile /cs/student/project_msc/2025/aibh/jgomezbe/Master-Thesis/utils/op/fused_bias_act_kernel.cu





build fused.so: link fused_bias_act.o fused_bias_act_kernel.cuda.o

default fused.so
